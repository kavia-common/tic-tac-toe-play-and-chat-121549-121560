# Backend configuration for Tic Tac Toe

# MongoDB connection (required)
# If you're running the provided tic_tac_toe_database locally via startup.sh,
# the default user/password/port are appuser/dbuser123/5000 with admin auth.
# Example local connection string (authSource=admin is required):
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin

# Database name (optional; aligns with DB_NAME default in database container's startup.sh)
MONGODB_DB=myapp

# OpenAI (optional; if not set, chat endpoint will return a playful fallback)
OPENAI_API_KEY=sk-your-openai-api-key
# Model to use for chat responses
OPENAI_MODEL=gpt-4o-mini
