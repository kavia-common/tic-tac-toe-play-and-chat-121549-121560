# Backend configuration for Tic Tac Toe Backend (FastAPI)
# Copy this file to ".env" and adjust values as needed for your environment.

# Full MongoDB connection URI
# If using the provided database container locally, the default credentials and port are:
#   user: appuser
#   password: dbuser123
#   port: 5000
# IMPORTANT: Include authSource=admin if logging in with a user created in the admin database.
# Example local connection:
# MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin
MONGODB_URL=

# Target database name (defaults to "myapp" if unset)
MONGODB_DB=myapp

# Optional OpenAI settings (leave OPENAI_API_KEY empty to use a deterministic fallback)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
