# Backend configuration for Tic Tac Toe

# MongoDB connection (required)
# Example: mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
# Database name (optional, defaults to tic_tac_toe)
MONGODB_DB=tic_tac_toe

# OpenAI (optional; if not set, chat endpoint will return a playful fallback)
OPENAI_API_KEY=sk-your-openai-api-key
# Model to use for chat responses
OPENAI_MODEL=gpt-4o-mini
